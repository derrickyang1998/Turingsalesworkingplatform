# TuringMarket / 图灵商务平台 environment template
# Copy to .env.local or your deployment secret manager. Do not commit real values.
# Real production values remain server-side; this public file documents variable names only.
# 真实生产值仅保存在服务器端；此公开文件只记录环境变量名称。

DEEPSEEK_API_KEY=replace_with_private_value
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
WEB_SEARCH_PROVIDER=replace_with_provider_name
TAVILY_API_KEY=replace_with_private_value
FEISHU_WEBHOOK_URL=replace_with_private_value

JWT_SECRET=replace_with_private_value
DEFAULT_ADMIN_USERNAME=replace_with_private_value
# Do not place a real default password in Git. Production should rotate users and remove seed-only defaults.
# 不要在 Git 中放置真实默认密码。生产环境完成轮换后应移除仅用于初始化的默认值。
DEFAULT_ADMIN_PASSWORD=replace_with_private_value

OBSIDIAN_KB_ROOT=D:\主盘\图灵集市
PLATFORM_KB_VAULT_ROOT=D:\图灵商务在线平台
OBSIDIAN_KB_IMPORT_ALLOWLIST=
PLATFORM_KB_EXPORT_ALLOWLIST=

SERVER_IP=replace_with_server_host
SERVER_PORT=3002
PUBLIC_HTTP_PORT=80
SERVER_DIR=/root/turingmarket/platform

GITHUB_REPO=replace_with_repository_url
